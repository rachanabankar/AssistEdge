APP_ENV=production
DATABASE_URL=postgresql://dummy-user:dummy-password@localhost:5432/dummy-db
# Dummy signing key; replace with a unique secret before running.
SECRET_KEY=dummy-replace-this-with-a-unique-secret
GROQ_API_KEY=dummy-groq-api-key
# Optional comma-separated model names.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional per-agent comma-separated model overrides.
GROQ_MODEL_SENTIMENT=openai/gpt-oss-120b
GROQ_MODEL_COACHING=openai/gpt-oss-120b
GROQ_MODEL_ESCALATION=openai/gpt-oss-120b
GROQ_MODEL_SUMMARY=openai/gpt-oss-120b
GROQ_MODEL_SIMULATOR=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
GOOGLE_CLIENT_ID=dummy-google-client-id
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
RESEND_API_KEY=dummy-resend-api-key
RESEND_FROM_EMAIL=demo@example.com
EMBEDDING_PROVIDER=local
HF_API_TOKEN=dummy-hugging-face-token
UPLOAD_DIR=static
CHROMA_PERSIST_DIR=./chroma_db
