# ==============================================================================
# AssistEdge Backend Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Security
# ------------------------------------------------------------------------------
# Application environment mode ('development' or 'production'). Defaults to 'development'.
# In production, OpenAPI/Swagger docs are disabled, strict CORS is required,
# FRONTEND_BASE_URL is required, and dev reset links are never returned.
APP_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
# Required when APP_ENV is 'production'. In development, defaults to localhost:5173 / localhost:5500.
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# ------------------------------------------------------------------------------
# LLM provider (Groq)
# ------------------------------------------------------------------------------
# Groq API key for multi-agent live coaching inference; get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ordered comma-separated fallback models for Groq inference
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Optional per-agent model overrides (if unset, GROQ_MODELS default list is used)
# GROQ_MODEL_SENTIMENT=llama-3.3-70b-versatile
# GROQ_MODEL_COACHING=llama-3.3-70b-versatile
# GROQ_MODEL_ESCALATION=llama-3.3-70b-versatile
# GROQ_MODEL_SUMMARY=llama-3.3-70b-versatile
# GROQ_MODEL_SIMULATOR=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# Authentication (JWT, Google OAuth)
# ------------------------------------------------------------------------------
# Secret key to sign and verify JWT access tokens; generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_jwt_signing_secret_here

# Google OAuth 2.0 Client ID (optional, only needed for Google login); get from Google Cloud Console > APIs & Services > Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Frontend & Application Settings
# ------------------------------------------------------------------------------
# Frontend base URL for constructing password-reset links (required in production; default: http://localhost:5173 in development)
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Email service (Resend)
# ------------------------------------------------------------------------------
# Resend API key for password-reset emails (optional, if omitted email sending is skipped); get from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email for password-reset emails (optional, default: onboarding@resend.dev); configure verified domain at https://resend.com/domains
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# SQLite is used by default (coaching_assistant.db is created automatically on startup in the backend folder).
# No additional database environment variables required for local development.
